{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://abn.os.enterprise/schemas/tenant-crew.json",
  "title": "Tenant onboarding crew \u2014 who onboarded a tenant, and what they were allowed to do",
  "description": "Shape only. The order of the steps, the mandate each member holds, the person-only acts and the go/no-go signature are enforced by scripts/check_tenant_crew_spec.py and specified in docs/core/tenant-crew.md.",
  "type": "object",
  "required": ["version", "contract", "tenant", "company", "pack", "boundary",
               "people", "units", "members", "steps", "goNoGo"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "contract": {
      "const": "tenant-crew@1",
      "description": "The onboarding-crew contract this record was written against."
    },
    "tenant": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$" },
    "company": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,30}$",
      "description": "The company inside the tenant (the tenant id for a single entity)."
    },
    "pack": {
      "type": "object",
      "required": ["id", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["ready", "draft"],
          "description": "The commercial pack's state when the crew started; onboarding may only start from `ready`."
        }
      }
    },
    "boundary": {
      "type": "string",
      "pattern": "^paperclip-boundary@\\d+\\.\\d+$",
      "description": "The boundary contract version in force when the crew ran."
    },
    "people": {
      "type": "array",
      "minItems": 1,
      "description": "The people the tenant was provisioned with \u2014 the owners and the only accounts that may sign a go/no-go.",
      "items": {
        "type": "object",
        "required": ["id", "role", "unit"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "unit": { "type": "string", "minLength": 1 }
        }
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "The org units the tenant's chart carries."
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "description": "The crew: agent accounts, each with an owner and a bounded mandate.",
      "items": {
        "type": "object",
        "required": ["id", "role", "unit", "kind", "owner", "purpose", "steps"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "unit": { "type": "string", "minLength": 1 },
          "kind": { "const": "agent" },
          "owner": {
            "type": "string",
            "minLength": 1,
            "description": "The person responsible for this agent (ADR-002 D4)."
          },
          "purpose": { "type": "string", "minLength": 1 },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": ["commercial", "company", "org", "accounts", "crew",
                       "folders", "plans", "verify"]
            },
            "description": "The onboarding steps this member may run \u2014 its mandate."
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "description": "What actually ran, in the order it ran.",
      "items": {
        "type": "object",
        "required": ["id", "by", "at", "result"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": ["commercial", "company", "org", "accounts", "crew",
                     "folders", "plans", "verify"]
          },
          "by": { "type": "string", "minLength": 1 },
          "at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
          "result": { "enum": ["ok", "refused"] }
        }
      }
    },
    "goNoGo": {
      "type": "object",
      "description": "The decision to hand the tenant over. A person signs it; no agent may.",
      "required": ["signedBy", "at", "decision"],
      "additionalProperties": false,
      "properties": {
        "signedBy": { "type": "string", "minLength": 1 },
        "at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
        "decision": { "enum": ["go", "no-go"] }
      }
    }
  }
}
