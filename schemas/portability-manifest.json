{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "company-portability@1",
  "title": "Portable company bundle manifest (company-portability@1)",
  "description": "What a company export ships and what an import verifies: the template with its contract pin, every artefact it cites with its digest, and the platform it is going to.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "contract", "company", "bundleId", "createdAt",
               "template", "artefacts", "platform"],
  "properties": {
    "version": { "const": 1 },
    "contract": { "const": "company-portability@1" },
    "company": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "bundleId": {
      "type": "string",
      "pattern": "^bundle-[0-9a-f]{16}$",
      "description": "content-addressed: company + template digest + every artefact, sorted"
    },
    "createdAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "contract"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^companies/[a-z][a-z0-9-]{1,63}/paperclip-company\\.json$",
          "description": "repository-relative, never absolute — an absolute path is a bundle that works on one machine"
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag", "sha"],
          "properties": {
            "tag": { "type": "string", "pattern": "^contract-[0-9]{4}\\.[0-9]{2}\\.[0-9]+$" },
            "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          }
        }
      }
    },
    "artefacts": {
      "type": "array",
      "description": "sorted by kind, then id — the id depends on the order, so two exports of the same state agree",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "id", "version", "sha256"],
        "properties": {
          "kind": { "enum": ["pack", "flow", "rule", "org"] },
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractTag"],
      "properties": {
        "contractTag": {
          "type": "string",
          "pattern": "^contract-[0-9]{4}\\.[0-9]{2}\\.[0-9]+$",
          "description": "where the bundle is going — recorded, never used to mutate it"
        }
      }
    }
  }
}
