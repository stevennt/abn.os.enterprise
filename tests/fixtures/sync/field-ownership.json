{
  "version": 1,
  "contract": "sync-semantics@1",
  "decided": "2026-11-10",
  "planes": [
    "enterprise",
    "paperclip",
    "opengate",
    "vault"
  ],
  "streams": [
    {
      "id": "model",
      "producer": "enterprise",
      "direction": "one-way",
      "watermark": {
        "field": "model.seq",
        "monotonic": true,
        "onReplay": "no-op"
      },
      "note": "the company model this repository compiles; nothing else authors it"
    },
    {
      "id": "tenant",
      "producer": "opengate",
      "direction": "one-way",
      "watermark": {
        "field": "tenant.seq",
        "monotonic": true,
        "onReplay": "no-op"
      },
      "note": "the tenant boundary: its profile, its companies, its folders, its ACL"
    },
    {
      "id": "identity",
      "producer": "opengate",
      "direction": "one-way",
      "watermark": {
        "field": "identity.seq",
        "monotonic": true,
        "onReplay": "no-op"
      },
      "note": "ONEID accounts and the seats they hold in Paperclip"
    },
    {
      "id": "work",
      "producer": "paperclip",
      "direction": "one-way",
      "watermark": {
        "field": "work.seq",
        "monotonic": true,
        "onReplay": "no-op"
      },
      "note": "tickets, comments, run logs and the approvals inbox — ephemeral by D2"
    },
    {
      "id": "evidence",
      "producer": "opengate",
      "direction": "one-way",
      "watermark": {
        "field": "evidence.seq",
        "monotonic": true,
        "onReplay": "no-op"
      },
      "note": "cases, documents and artifacts of record — the durable half of a run"
    },
    {
      "id": "money",
      "producer": "opengate",
      "direction": "one-way",
      "watermark": {
        "field": "money.seq",
        "monotonic": true,
        "onReplay": "no-op"
      },
      "note": "plans, quotas, statements and metered spend — billing truth by D5"
    },
    {
      "id": "audit",
      "producer": "opengate",
      "direction": "one-way",
      "watermark": {
        "field": "audit.seq",
        "monotonic": true,
        "onReplay": "no-op"
      },
      "note": "the signed audit chain"
    },
    {
      "id": "secret-ref",
      "producer": "opengate",
      "direction": "one-way",
      "watermark": {
        "field": "secret-ref.seq",
        "monotonic": true,
        "onReplay": "no-op"
      },
      "note": "the name of a secret and where it lives"
    },
    {
      "id": "secret-value",
      "producer": "vault",
      "direction": "one-way",
      "watermark": {
        "field": "secret-value.seq",
        "monotonic": true,
        "onReplay": "no-op"
      },
      "note": "the secret itself, injected into a run environment and never stored"
    }
  ],
